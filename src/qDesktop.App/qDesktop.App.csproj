<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WPF 与 WinForms 共存时，WindowsDesktop SDK 会注入 System.Windows.Forms 全局 using，
      导致 Application / MessageBox / Clipboard 等类型与 WPF 同名类型产生 CS0104 二义性。
      后续阶段仅用 WinForms 的 NotifyIcon（阶段 9 托盘），故移除该全局 using，需要时显式引用。
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\qDesktop.Core\qDesktop.Core.csproj" />
    <ProjectReference Include="..\qDesktop.Interop\qDesktop.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
