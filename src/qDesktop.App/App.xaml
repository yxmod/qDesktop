<Application x:Class="qDesktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:qDesktop.App">
    <!--
        不设置 StartupUri：主窗口由 App.OnStartup 从 DI 容器解析后显示，
        以保证窗口及其依赖（视图模型、服务）统一由容器装配。
    -->
    <Application.Resources>
        <!--
            阶段 1 临时验证资源：Demo 窗口的可见性转换器。
            必须置于 Application 资源（而非窗口自身资源）——窗口根元素上的
            StaticResource 在窗口资源字典解析之前求值，否则将抛 XamlParseException。
            随 Demo 窗口一并在阶段 4 删除。
        -->
        <local:BoolToHiddenVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Application.Resources>
</Application>
